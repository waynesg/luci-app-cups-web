#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1

PROG=/usr/bin/cups-web

start_service() {
    local enabled port cups_host db_path upload_dir

    config_load cups-web
    config_get enabled main enabled '0'
    config_get port main port '8080'
    config_get cups_host main cups_host 'localhost'
    config_get db_path main db_path '/var/lib/cups-web/data/cups-web.db'
    config_get upload_dir main upload_dir '/var/lib/cups-web/uploads'

    [ "$enabled" = "1" ] || {
        echo "cups-web is disabled"
        return 1
    }

    [ -x "$PROG" ] || {
        echo "cups-web binary not found. Run /usr/libexec/cups-web-install first."
        return 1
    }

    # Create directories if not exist
    mkdir -p "$(dirname "$db_path")"
    mkdir -p "$upload_dir"

    procd_open_instance
    procd_set_param command "$PROG" -addr ":$port"
    procd_set_param env CUPS_HOST="$cups_host"
    procd_set_param env DB_PATH="$db_path"
    procd_set_param env UPLOAD_DIR="$upload_dir"
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    service_stop "$PROG"
}
