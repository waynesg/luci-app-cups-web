#!/bin/sh

# Detect architecture
ARCH=$(uname -m)
case "$ARCH" in
    x86_64|amd64)
        ARCH="amd64"
        ;;
    aarch64|arm64)
        ARCH="arm64"
        ;;
    armv7*|armhf)
        ARCH="armv7"
        ;;
    *)
        echo "Error: Unsupported architecture: $ARCH"
        exit 1
        ;;
esac

echo "Detected architecture: $ARCH"
echo "Downloading cups-web binary..."

URL="https://github.com/hanxi/cups-web/releases/latest/download/cups-web-linux-${ARCH}"

wget -O /usr/bin/cups-web "$URL"
if [ $? -ne 0 ]; then
    echo "Error: Failed to download cups-web binary"
    exit 1
fi

chmod +x /usr/bin/cups-web

# Create data directories
mkdir -p /var/lib/cups-web/data
mkdir -p /var/lib/cups-web/uploads

echo "Done. cups-web installed successfully."
